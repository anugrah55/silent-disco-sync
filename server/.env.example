# Copy to server/.env for local overrides. Never commit the real .env.
PORT=3000
NODE_ENV=development
# Extra origins allowed on the WebSocket upgrade, comma separated.
# Same-origin (Origin host == Host header) is always allowed.
ALLOWED_ORIGINS=
# Default scheduling lead time in ms when auto lead is disabled (1500-4000).
LEAD_MS_DEFAULT=2000
# Number of reverse-proxy hops to trust for client IPs (rate limiting). 1 on Render.
TRUST_PROXY=0
# Optional path overrides (defaults shown in the README).
# CLIENT_DIST=../client/dist
# ASSETS_DIR=./assets
# UPLOAD_DIR=/tmp/sds-uploads

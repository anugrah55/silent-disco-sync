# Copy to client/.env.local for local overrides. Never commit real env files.
# Public origin encoded in the QR join link. Leave empty to use the page's own origin.
# Useful in dev when the laptop is opened via localhost but phones need the LAN IP,
# e.g. VITE_PUBLIC_ORIGIN=http://192.168.1.20:5173
VITE_PUBLIC_ORIGIN=

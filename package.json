{
  "name": "silent-disco-sync",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client",
    "sim"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w client && npm run build -w server",
    "start": "node server/dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sim": "npm run sim -w sim --"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "vitest": "^4.1.12",
    "typescript": "~6.0.3",
    "eslint": "^10.13.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.72.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "@types/node": "^20.19.43"
  }
}
